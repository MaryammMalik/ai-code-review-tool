# Copy this file to ".env" and add your own key to review with the
# OpenAI API (see Modules 8-9). Without a key, the tool runs its
# offline AST-based static checks instead — same report format,
# same validation, exact line numbers.
OPENAI_API_KEY=your_openai_api_key_here

# Optional override:
# OPENAI_MODEL=gpt-4o-mini
